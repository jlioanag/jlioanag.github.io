---
import Link from "./Link.astro";
import { Icon } from "astro-icon/components";

const links = [
  {
    href: "/",
    title: "home",
    icon: "tabler:home",
  },
  {
    href: "/blog",
    title: "blog",
    icon: "tabler:news",
  },
  {
    href: "https://github.com/jlioanag",
    title: "github",
    icon: "tabler:brand-github",
  },
  {
    href: "https://linkedin.com/in/jlioanag",
    title: "linkedin",
    icon: "tabler:brand-linkedin",
  },
];
---

<nav
  class="z-50 sm:text-xl text-md flex justify-between items-center mx-auto px-5 pt-5"
>
  <div
    class="flex text-brown-500 hover:text-brown-700 transition-colors duration-200"
  >
    julian lioanag
  </div>
  <div class="flex items-center">
    {
      links.map((link) => (
        <div class="mx-1 px-1 transition ease-in-out duration-200">
          <Link
            nav={link.href}
            text={link.icon ? "" : link.title}
            showArrow={!link.icon}
            class="mx-1 flex navbar-item"
          >
            {link.icon && (
              <Icon name={link.icon} class="w-6 h-6" title={link.title} />
            )}
          </Link>
        </div>
      ))
    }
  </div>
</nav>
